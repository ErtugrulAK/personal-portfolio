// Cloud Firestore Security Rules
// Enforces document-level user isolation by validating authenticated user UID against task document ownership.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tasks Collection Rules
    match /tasks/{taskId} {
      // Allow user to read a task document if they own it
      allow read: if request.auth.uid == resource.data.userId;

      // Allow user to create a task if authenticated and binding their own UID
      allow create: if request.auth.uid == request.resource.data.userId;

      // Allow user to update or delete a task if they own it
      allow update, delete: if request.auth.uid == resource.data.userId;
    }
  }
}